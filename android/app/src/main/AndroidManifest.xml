<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Draw the warm screen filter above other apps. Granted by the user in
         Settings > Apps > Special access > Display over other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Keep the filter alive while the user works in other apps. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Restore the filter and the schedule after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Schedule boundaries. Exact alarms are optional; the app degrades to
         inexact alarms when the user has not granted this special access. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Biometric app lock. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Optional: sunrise/sunset scheduling from the device position. The
         location is only read when the user picks "Use my location". -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Battery optimisation guidance (the user must confirm the request). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Per-app profiles need the foreground app name. The user grants this in
         Settings > Special access > Usage access. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:label="LumaShield"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/NormalTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.OverlayFilterService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Applies a user controlled blue light reduction overlay above other apps until the user turns protection off." />
        </service>

        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.ScheduleAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.ProtectionActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.EyeBreakReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.lumashield.app.action.EYE_BREAK" />
                <action android:name="com.lumashield.app.action.EYE_BREAK_DONE" />
                <action android:name="com.lumashield.app.action.EYE_BREAK_SNOOZE" />
                <action android:name="com.lumashield.app.action.EYE_BREAK_START" />
                <action android:name="com.lumashield.app.action.EYE_STATUS_REFRESH" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.FilterWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.lumashield.app.widget.TOGGLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/filter_widget_info" />
        </receiver>

        <service
            android:name=".service.FilterTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Lets the per-app profile screen list launchable apps without
             requesting the restricted QUERY_ALL_PACKAGES permission. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
</manifest>
